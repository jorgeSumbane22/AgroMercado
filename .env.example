# Configuração local/produtiva do AgroMercado.
# Copie para .env (na raiz do projeto) e ajuste. Nunca versionar o ficheiro .env real.
# Formato: CHAVE=valor (aspas opcionais; linhas começadas por # são comentários).
# Variáveis definidas no ambiente real (Apache SetEnv, sistema) têm prioridade sobre o .env.

# --- Base de dados ---
AGRO_DB_HOST=127.0.0.1
AGRO_DB_NAME=agro_marketplace
AGRO_DB_USER=root
AGRO_DB_PASS=

# Caminho da aplicação no servidor: /agro-marketplace no XAMPP; vazio quando instalada na raiz do domínio.
AGRO_BASE_PATH=/agro-marketplace

# --- Ambiente ---
# local = mostra links de teste (recuperação/confirmação de email) no ecrã; production = nunca.
APP_ENV=local
# 1 mostra erros PHP no browser (apenas desenvolvimento).
APP_DEBUG=0

# --- Email / SMTP ---
# Valores NÃO vazios aqui sobrepõem-se a Admin → Configurações (o campo fica só de leitura).
# Deixe vazio para gerir no painel. Sem SMTP, os emails ficam registados em Admin → Emails enviados.
MAIL_ENABLED=
MAIL_FROM=
SMTP_HOST=
# 587 com SMTP_SECURE=tls (STARTTLS) ou 465 com SMTP_SECURE=ssl.
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=

# --- Pagamentos ---
PAYMENT_MPESA_ENABLED=0
PAYMENT_EMOLA_ENABLED=0
PAYMENT_WEBHOOK_SECRET=gere-um-segredo-longo-e-aleatorio

# --- Alojamento: configuração inicial (uso único) ---
# Só para instalações feitas com database/hosting.sql. Escreva uma chave longa (24+ caracteres),
# abra /setup.php?key=A-CHAVE para definir o SuperAdmin e, no fim, APAGUE esta linha (ver HOSPEDAGEM.md).
AGRO_SETUP_KEY=
