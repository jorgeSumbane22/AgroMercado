Options -Indexes

# Pastas internas nunca são servidas pela web (base de dados, backups, ferramentas, testes, registos)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(database|backups|tools|tests|logs|storage)(/|$) - [F,L]
</IfModule>
<FilesMatch "\.(sql|log|ini|bak|env|md|txt|sh|example)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(debug-imagens\.php|\.env.*|\.gitignore)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
